name: Build Terminal OS

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install tools
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential busybox-static grub-pc-bin grub-efi-amd64-bin grub-common xorriso mtools cpio gzip linux-image-virtual

      - name: Create init.c and build rootfs
        run: |
          mkdir -p build/rootfs/{bin,sbin,etc,proc,sys,dev,root,tmp,usr/bin,usr/sbin}
          mkdir -p build/iso/boot/grub

          cat << 'EOF' > init.c
          #include <stdio.h>
          #include <stdlib.h>
          #include <string.h>
          #include <unistd.h>
          #include <fcntl.h>
          #include <sys/mount.h>
          #include <sys/stat.h>
          #include <sys/wait.h>
          #include <sys/ioctl.h>
          #include <sys/reboot.h>

          void setup_console() {
              int fd = open("/dev/console", O_RDWR);
              if (fd >= 0) {
                  ioctl(fd, TIOCSCTTY, 1);
                  dup2(fd, 0);
                  dup2(fd, 1);
                  dup2(fd, 2);
                  if (fd > 2) close(fd);
              }
          }

          int main() {
              mkdir("/proc", 0755);
              mkdir("/sys", 0755);
              mkdir("/dev", 0755);
              mkdir("/etc", 0755);
              mkdir("/root", 0755);
              mkdir("/tmp", 0777);

              mount("proc", "/proc", "proc", 0, "");
              mount("sysfs", "/sys", "sysfs", 0, "");
              mount("devtmpfs", "/dev", "devtmpfs", 0, "");

              setup_console();
              sethostname("terminal", 8);

              const char charset[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*_-";
              char password[17] = "root123456789012";
              FILE *urandom = fopen("/dev/urandom", "rb");
              if (urandom != NULL) {
                  for (int i = 0; i < 16; i++) {
                      unsigned char b;
                      if (fread(&b, 1, 1, urandom) == 1) {
                          password[i] = charset[b % (sizeof(charset) - 1)];
                      }
                  }
                  password[16] = '\0';
                  fclose(urandom);
              }

              FILE *passwd = fopen("/etc/passwd", "w");
              if (passwd) {
                  fprintf(passwd, "root:x:0:0:root:/root:/bin/sh\n");
                  fclose(passwd);
              }

              system("ip link set lo up 2>/dev/null");
              system("ip link set eth0 up 2>/dev/null");
              system("udhcpc -i eth0 -n -q -t 2 2>/dev/null");
              system("echo 'nameserver 8.8.8.8' > /etc/resolv.conf");

              if (access("/sys/class/net/wlan0", F_OK) == 0) {
                  char wifi_name[64];
                  char wifi_pass[64];
                  char cmd[256];
                  printf("Wi-Fi SSID: ");
                  fflush(stdout);
                  if (scanf("%63s", wifi_name) == 1) {
                      printf("Wi-Fi Pass: ");
                      fflush(stdout);
                      if (scanf("%63s", wifi_pass) == 1) {
                          system("rfkill unblock wifi 2>/dev/null");
                          system("ip link set wlan0 up 2>/dev/null");
                          snprintf(cmd, sizeof(cmd), "wpa_passphrase \"%s\" \"%s\" > /etc/wpa.conf", wifi_name, wifi_pass);
                          system(cmd);
                          system("wpa_supplicant -B -i wlan0 -c /etc/wpa.conf 2>/dev/null");
                          system("udhcpc -i wlan0 -n -q -t 2 2>/dev/null");
                      }
                  }
              }

              printf("\033[2J\033[H\033[1;32m");
              printf("  +------------------------+\n");
              printf("  |   \\                    |\n");
              printf("  |    \\                   |\n");
              printf("  |     >                  |\n");
              printf("  |    /                   |\n");
              printf("  |   /   ________         |\n");
              printf("  +------------------------+\n");
              printf("         [ terminal ]\n\n");
              printf("  user : root\n");
              printf("  pass : %s\n\n\033[0m", password);
              fflush(stdout);

              char *args[] = {"/bin/sh", NULL};
              char *envp[] = {
                  "PATH=/bin:/sbin:/usr/bin:/usr/sbin",
                  "HOME=/root",
                  "TERM=linux",
                  "PS1=\\e[1;32mroot@terminal:\\w# \\e[0m",
                  NULL
              };

              while (1) {
                  pid_t pid = fork();
                  if (pid == 0) {
                      execve("/bin/sh", args, envp);
                      exit(1);
                  } else if (pid > 0) {
                      int status;
                      waitpid(pid, &status, 0);
                  } else {
                      sleep(1);
                  }
              }
              return 0;
          }
          EOF

          gcc -static -O2 init.c -o build/rootfs/init
          chmod +x build/rootfs/init

          cp /bin/busybox build/rootfs/bin/busybox
          chmod +x build/rootfs/bin/busybox
          for cmd in $(/bin/busybox --list); do
            ln -sf busybox build/rootfs/bin/$cmd
          done

          cd build/rootfs
          find . -print0 | cpio --null -ov --format=newc | gzip -9 > ../iso/boot/initrd.img

      - name: Build ISO and Release
        run: |
          sudo cp /boot/vmlinuz-* build/iso/boot/vmlinuz
          sudo chmod 644 build/iso/boot/vmlinuz

          cat << 'EOF' > build/iso/boot/grub/grub.cfg
          set timeout=0
          set default=0

          menuentry "terminal" {
              linux /boot/vmlinuz root=/dev/ram0 rw console=tty0
              initrd /boot/initrd.img
          }
          EOF

          grub-mkrescue -o terminal.iso build/iso/

      - name: Publish Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.${{ github.run_number }}
          name: Terminal OS v1.0.${{ github.run_number }}
          files: terminal.iso
